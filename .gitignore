# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
env/

# Data - don't push uploads or exports
uploads/
exports/
data/images/
# DB is included for Railway deployment (contains catalog data)

# Semantic search index — a local artifact rebuilt from the catalog DB on
# startup; large binary, machine-specific, never committed.
data/semantic_index.npz
data/semantic_index.prod.npz

# Session signing key — committing this would let anyone forge a login cookie
data/.session_secret

# Local DB snapshots taken before risky edits (25MB+, machine-specific)
data/backups/

# Demo/marketing assets, not source
*.pptx

# Test files
test_*.py
check_db.py
fix_gst.py
test_quote.xlsx
*.xlsx
*.xls

